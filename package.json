{
  "name": "use-postal-ph",
  "version": "1.1.15",
  "description": "This utility library is specifically designed for the Philippines, providing comprehensive information on postal codes,\nmunicipalities, locations, and regions. Moreover, searching within the library is case insensitive.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/blckclov3r/use-postal-ph#readme",
  "keywords": [
    "use-postal",
    "use-ph",
    "use-postal-ph",
    "postal-ph",
    "philippines",
    "zipcode",
    "postal-code",
    "address",
    "municipality",
    "region",
    "geolocation",
    "utility-library",
    "hooks",
    "use-postal-ph",
    "use-ph",
    "philippine-postal-codes",
    "location-data",
    "offline-geolocation",
    "philippine-zipcode",
    "ph-postal-codes",
    "filipino-zipcode",
    "postal-address",
    "region-data",
    "location-hooks",
    "philippine-utility",
    "geospatial-data",
    "localization",
    "city-postal-codes",
    "zip-code-lookup",
    "address-lookup",
    "ph-zipcode",
    "localization-library",
    "geo-data",
    "address-validation",
    "philippine-address",
    "address-format",
    "postcode-lookup",
    "philippine-geo-data",
    "location-based",
    "address-search",
    "geospatial-library",
    "postal-system",
    "location-services",
    "filipino-address",
    "postal-code-utility",
    "country-postal-codes",
    "address-utility",
    "geolocation-hooks",
    "location-utils",
    "city-lookup",
    "area-codes",
    "zipcode-validation",
    "postal-code-search"
  ],
  "author": "blckclov3r",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/blckclov3r/use-postal-ph.git"
  },
  "bugs": {
    "url": "https://github.com/blckclov3r/use-postal-ph/issues",
    "email": "blckclov3r@gmail.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@swc/core": "^1.15.18",
    "@types/node": "^25.5.0",
    "terser": "^5.46.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "npx playwright test tests/index.spec.ts",
    "test-headed": "npx playwright test tests/index.spec.ts --headed",
    "report": "playwright show-report",
    "build": "tsup",
    "start": "node dist/index.js"
  }
}
